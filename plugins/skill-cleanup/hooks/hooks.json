{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null 2>&1 && python3 \"${CLAUDE_PLUGIN_ROOT}/skills/skill-cleanup/scripts/skillctl.py\" hook 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
